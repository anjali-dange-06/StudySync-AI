# Copy this file to .env and add your own key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs are configurable; these defaults are supported in the Gemini API model catalog.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. Relative paths are resolved from the project directory.
# STUDYPILOT_DB_PATH=data/studypilot.db
MAX_PDF_MB=20
